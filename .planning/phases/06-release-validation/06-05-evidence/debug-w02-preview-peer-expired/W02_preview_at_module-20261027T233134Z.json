      "primary-resource-audit.json",
      "peer-stderr.log",
      "peer-stdout.log",
      "peer-traceback.log",
      "peer-result.json",
      "peer-resource-audit.json"
    ],
    "note": "隔離runの原本は .planning/tmp/ にも残る。ここはその写し(診断実行ごとに別ディレクトリ)"
  }
